SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
KPPL_SESSION_SECRET=replace-with-at-least-32-random-characters
KPPL_SETUP_SECRET=replace-with-a-long-random-one-time-secret
KPPL_CRON_SECRET=replace-with-a-long-random-secret

# Set only while running scripts/create_admin.php, then remove from the environment
KPPL_ADMIN_EMPLOYEE_ID=replace-with-admin-id
KPPL_ADMIN_PASSWORD=replace-with-a-strong-password-of-12-or-more-characters
KPPL_ADMIN_FIRST_NAME=ผู้ดูแลระบบ
KPPL_ADMIN_LAST_NAME=
KPPL_ADMIN_BRANCH=กปภ.สาขาพิษณุโลก

# Legacy PHP/MySQL deployment only
KPPL_DB_HOST=127.0.0.1
KPPL_DB_PORT=3306
KPPL_DB_NAME=kppl_db
KPPL_DB_USER=kppl_user
KPPL_DB_PASS=replace-with-a-strong-password

# Optional external data sources
KPPL_API_TOKEN=
KPPL_API_USERNAME=
KPPL_API_PASSWORD=
KPPL_API_KEY=
KPPL_ERP_USER=
KPPL_ERP_PASS=
